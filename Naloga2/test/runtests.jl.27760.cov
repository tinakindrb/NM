        - using Test
        - include("../src/Naloga2.jl")
        - using .Naloga2
        - 
        - @testset "Simpsonovo pravilo" begin
        -     # Integral x^2 od 0 do 1 = 1/3
        5     f1(x) = x^2
        -     result1 = simpsonovo_pravilo(f1, 0.0, 1.0, 4)  # 4 podintervali
        -     @test isapprox(result1, 1/3, atol=1e-10)
        - 
        -     # Integral sin(x) od 0 do π = 2
     1001     f2(x) = sin(x)
        -     result2 = simpsonovo_pravilo(f2, 0.0, Float64(π), 1000)  # več intervalov za večjo natančnost
        -     @test isapprox(result2, 2.0, atol=1e-10)
        - end
        - 
        - 
        - @testset "Standardna normalna CDF F(x)" begin
        -     # F(0) = 0.5
        -     @test isapprox(F(0.0), 0.5, atol=1e-10)
        - 
        -     # F(1) ≈ 0.841344746...
        -     @test isapprox(F(1.0), 0.841344746, atol=1e-10)
        - 
        -     # F(-1.96) ≈ 0.025
        -     @test isapprox(F(-1.96), 0.025, atol=1e-3)  # malo manj strog atol zaradi repa
        - 
        -     # F(5) ≈ 0.999999713...
        -     @test isapprox(F(5.0), 0.999999713, atol=1e-8)
        - end
