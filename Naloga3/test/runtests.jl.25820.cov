        - using Test
        - include("../src/Naloga3.jl")
        - using .Naloga3
        - 
        - @testset "TestDopri5" begin
        - 
        -     @testset "Basic ODE" begin
      224         f(t, y) = -2 .* y
        -         tspan = (0.0, 5.0)
        -         y0 = [1.0]
        -         epsilon = 1e-6
        -         sigma = 0.9
        - 
        -         T, Y = dopri5(f, tspan, y0, epsilon, sigma)
        - 
        -         # Analitična rešitev
       33         y_expected(t) = exp(-2 * t)
        - 
        -         for (ti, yi) in zip(T, eachrow(Y))
        -             @test isapprox(yi[1], y_expected(ti); atol=1e-5)
        -         end
        -     end
        - 
        -     @testset "Error Control" begin
      252         f(t, y) = [-t * y[1]^2]
        -         tspan = (0.0, 2.0)
        -         y0 = [1.0]
        -         epsilon = 1e-8
        -         sigma = 0.9
        - 
        -         T, Y = dopri5(f, tspan, y0, epsilon, sigma)
        - 
        -         # Analitična rešitev: y(t) = 1 / (1 + 0.5 t^2)
       35         y_expected(t) = 1 / (1 + 0.5 * t^2)
        - 
        -         for (ti, yi) in zip(T, eachrow(Y))
        -             @test isapprox(yi[1], y_expected(ti); atol=1e-6)
        -         end
        -     end
        - 
        - end
