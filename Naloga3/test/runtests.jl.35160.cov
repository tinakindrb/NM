        - using Test
        - include("../src/Naloga3.jl")
        - using .Naloga3
        - 
        - @testset "TestDopri5" begin
        - 
        -     @testset "Basic ODE" begin
      224         f(t, y) = -2 .* y
        -         tspan = (0.0, 5.0)
        -         y0 = [1.0]
        -         epsilon = 1e-6
        -         sigma = 0.9
        - 
        -         T, Y = dopri5(f, tspan, y0, epsilon, sigma)
        - 
        -         # Analitična rešitev
       33         y_expected(t) = exp(-2 * t)
        - 
        -         for (ti, yi) in zip(T, eachrow(Y))
        -             @test isapprox(yi[1], y_expected(ti); atol=1e-5)
        -         end
        -     end
        - 
        -     @testset "Error Control" begin
      252         f(t, y) = [-t * y[1]^2]
        -         tspan = (0.0, 2.0)
        -         y0 = [1.0]
        -         epsilon = 1e-8
        -         sigma = 0.9
        - 
        -         T, Y = dopri5(f, tspan, y0, epsilon, sigma)
        - 
        -         # Analitična rešitev: y(t) = 1 / (1 + 0.5 t^2)
       35         y_expected(t) = 1 / (1 + 0.5 * t^2)
        - 
        -         for (ti, yi) in zip(T, eachrow(Y))
        -             @test isapprox(yi[1], y_expected(ti); atol=1e-6)
        -         end
        -     end
        - 
        - end
        - 
        - @testset "Test sistem_nihalo" begin
        - 
        -     @testset "Stacionarno ravnovesje" begin
        -         # če je kot = 0 in kotna_hitrost = 0, potem so odvodi oba 0
        -         odvod = sistem_nihalo(0.0, [0.0, 0.0])
        -         @test isapprox(odvod[1], 0.0; atol=1e-12)
        -         @test isapprox(odvod[2], 0.0; atol=1e-12)
        -     end
        - 
        -     @testset "Pozitivna kotna_hitrost" begin
        -         # če je kot = 0, potem mora biti odvod kota enak kotni hitrosti
        -         odvod = sistem_nihalo(0.0, [0.0, 2.0])
        -         @test isapprox(odvod[1], 2.0; atol=1e-12)
        -         @test isapprox(odvod[2], 0.0; atol=1e-12)
        -     end
        - 
        -     @testset "Negativen kot" begin
        -         # če je kot = -pi/2, potem je odvod kotne hitrosti = -(g/l)*sin(kot)
        -         kot = -pi/2
        -         kotna_hitrost = 0.0
        -         odvod = sistem_nihalo(0.0, [kot, kotna_hitrost])
        -         @test isapprox(odvod[1], 0.0; atol=1e-12)
        -         @test isapprox(odvod[2], -(9.81/1.0)*sin(kot); atol=1e-12)
        -     end
        - 
        - end
        - 
