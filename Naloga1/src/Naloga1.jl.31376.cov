        - module Naloga1
        - 
        - using LinearAlgebra
        - 
        - export ZgornjiHessenberg, hessenberg, SpTridiag, lu
        - 
        - """
        - ZgornjiHessenberg(H)
        - 
        - Podatkovni tip za zgornje Hessenbergove matrike. Shranjuje kvadratno matriko H,
        - ki ima lahko neničelne elemente na glavni diagonali, na prvi poddiagonali in
        - na vseh naddiagonalnih mestih. Vsi elementi pod prvo poddiagonalo morajo biti 0.
        - """
        - struct ZgornjiHessenberg
        -     H::Matrix{Float64}
        - 
       12     function ZgornjiHessenberg(H::AbstractMatrix)
       12         n, m = size(H)
       12         if n != m
        1             error("Matrika mora biti kvadratna.")
        -         end
        -         # preverimo Hessenberg lastnost: ničle pod drugo poddiagonalo
       11         for i = 3:n
       16             for j = 1:(i-2)
       22                 if abs(H[i, j]) > 1e-12
        1                     error("Matrika ni zgornja Hessenbergova (element H[$i,$j] ≠ 0).")
        -                 end
       27             end
       20         end
       10         new(Matrix{Float64}(H))
        -     end
        - end
        - 
        - Base.show(io::IO, Z::ZgornjiHessenberg) = print(io, "ZgornjiHessenberg:\n", Z.H)
        - 
        - """
        - hessenberg(A)
        - 
        - Pretvori kvadratno matriko A v zgornjo Hessenbergovo obliko s pomočjo
        - Householderjevih zrcaljenj.
        - 
        - Rezultat je matrika H tipa ZgornjiHessenberg in ortogonalna matrika Q,
        - tako da velja: H = Q'*A*Q
        - 
        - # Vhod:
        - - A : kvadratna matrika
        - 
        - # Izhod:
        - - H : ZgornjiHessenberg (zgornja Hessenbergova matrika)
        - - Q : ortogonalna matrika
        - """
        - 
        3 function hessenberg(A::AbstractMatrix)
        3     n, m = size(A)
        - 
        3     H = Matrix{Float64}(A) # kopija A
        3     Q = Matrix{Float64}(I, n, n)
        - 
        3     for k = 1:n-2
        -         # vektor pod diagonalo v stolpcu k
        6         x = H[k+1:n, k]
        - 
        -         # Householderjev vektor
        6         e = zeros(length(x))
        3         e[1] = norm(x)
        3         if norm(x) == 0
        2             v = zeros(size(x))
        -         else
        2             v = sign(x[1]) * e + x
        2             v /= norm(v)
        -         end
        - 
        -         # refleksija
        3         P = Matrix{Float64}(I, length(v), length(v)) - 2 * (v * v')
        - 
        -         # posodobimo H in Q (uporabimo P na pravem podbloku)
        3         H[k+1:n, k:n] = P * H[k+1:n, k:n]
        3         H[1:n, k+1:n] = H[1:n, k+1:n] * P
        3         Q[k+1:n, :]   = P * Q[k+1:n, :]
        3     end
        - 
        -     #print(H)
        - 
        3     return ZgornjiHessenberg(H), Q'
        - end
        - 
        - """
        - SpTridiag(sd)
        - 
        - Podatkovni tip za spodnje tridiagonalne matrike z enicami na glavni diagonali.
        - 
        - - sd : vektor dolžine n-1 z elementi poddiagonale
        - - glavna diagonala je privzeto [1, 1, ..., 1]
        - - vsi ostali elementi so 0
        - """
        - struct SpTridiag
        7     d::Vector{Float64}
        -     sd::Vector{Float64}
        - end
        - 
        - """
        - Matrix(L)
        - 
        - Pretvori elemente iz SpTridiag v polno matriko
        - 
        - - Glavna diagonala je podana z vektorjem d, 
        - - Poddiagonala je podana z vektorjem sd,
        - - Vsi ostali elementi matrike so enaki 0.
        - 
        - """
        - 
        6 function Matrix(L::SpTridiag)
        6     n = length(L.d)
       84     M = zeros(Float64, n, n)
        6     for i = 1:n
       22         M[i,i] = L.d[i] #glavna diagonala
       38     end
        6     for i = 1:n-1
       16         M[i+1,i] = L.sd[i] #poddiagonala
       26     end
        6     return M
        - end
        - 
        - """
        - \\(L, b)
        - 
        - Reši sistem linearnih enačb L * x = b, kjer je L spodnja tridiagonalna
        - matrika tipa SpTridiag.
        - 
        - - Argument b je desna stran sistema.
        - 
        - Vrne rešitev x kot vektor dolžine n.
        - """
        - 
        - import Base: \
        - 
        3 function \(L::SpTridiag, b::Vector{Float64})
        3     n = length(L.d)
        3     if length(b) != n
        1         throw(ArgumentError("Dimenzije se ne ujemajo"))
        -     end
        - 
        4     x = similar(b)
        2     x[1] = b[1] / L.d[1]
        2     for i = 2:n
        5         x[i] = (b[i] - L.sd[i-1] * x[i-1]) / L.d[i]
        8     end
        2     return x
        - end
        - 
        - """
        - lu(H)
        - 
        - Izvede LU razcep zgornje Hessenbergove matrike H.
        - 
        - Vrne:
        - - L : spodnja tridiagonalna matrika tipa SpTridiag z enicami na diagonali,
        - - U : zgornje trikotna matrika.
        - """
        4 function lu(Z::ZgornjiHessenberg)
        4     H = copy(Z.H)
        4     n = size(H, 1)
        - 
       15     d  = ones(Float64, n) #glavna diagonala L (same enice)
       11     sd = zeros(Float64, n-1) #poddiagonala L
       59     U  = zeros(Float64, n, n) #U kot polna matrika
        - 
        -     #inicializacija prve vrstice U
        4     U[1, :] = H[1, :]
        - 
        4     for i = 1:n-1
        -         #element L[i+1, i]
       11         sd[i] = H[i+1, i] / U[i, i]
        - 
        -         #naslednja vrstica v U
       11         U[i+1, i+1:n] = H[i+1, i+1:n] - sd[i] * U[i, i+1:n]
       18     end
        - 
        4     L = SpTridiag(d, sd)
        4     return L, U
        - end
        - 
        - 
        - end #modul Naloga1
